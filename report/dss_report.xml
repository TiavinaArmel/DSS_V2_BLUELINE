<?xml version="1.0" encoding="utf-8"?>
<!-- Ce fichier décrit un rapport PDF au format XML utilisé par Odoo. -->
<odoo>
    <!-- Hérite du bundle CSS commun aux rapports pour ajouter les styles du bon DSS. -->
    <template id="report_assets_dss" inherit_id="report.assets_common">
        <!-- Le point XPath . cible le bundle complet ; inside ajoute le lien sans remplacer son contenu. -->
        <xpath expr="." position="inside">
            <!-- Charge la feuille CSS qui met en forme le document PDF DSS. -->
            <link rel="stylesheet" type="text/css"
                href="/dss_v2/static/src/css/report_bl.css" />
        </xpath>
    </template>

    <!-- Definit le contenu du bon de livraison DSS. -->
    <!-- Cet identifiant QWeb est référencé par l'action d'impression plus bas. -->
    <template id="report_bon_livraison_document">
        <!-- Appelle le conteneur HTML standard requis par les rapports QWeb. -->
        <t t-call="report.html_container">
            <!-- docs contient les enregistrements demandés ; la boucle nomme chacun d'eux o. -->
            <t t-foreach="docs" t-as="o">
                <!-- Ajoute l'en-tête et le pied de page standards configurés dans Odoo. -->
                <t t-call="report.external_layout">
                    <!-- Cette classe regroupe les styles propres au document. -->
                    <div class="page dss-bl">
                        <!-- Titre imprimé en haut de chaque page de bon de livraison. -->
                        <h2 class="dss-bl-title">BON DE LIVRAISON</h2>

                        <!-- Informations sur le destinataire et la demande. -->
                        <table class="dss-header">
                            <tr>
                                <td class="dss-header-left">
                                    <!-- t-field lit un champ de l'enregistrement courant et applique son format Odoo. -->
                                    <div class="dss-info-line">
                                        <strong>DESTINATAIRE :</strong>
                                        <!-- Nom du partenaire destinataire lié à la demande. -->
                                        <span t-field="o.partner_id.name" />
                                    </div>
                                    <div class="dss-info-line">
                                        <strong>INTERVENTION :</strong>
                                        <!-- Type d'intervention choisi pour cette demande. -->
                                        <span t-field="o.type_intervention" />
                                    </div>
                                    <div class="dss-info-line">
                                        <strong>LIEU D'INTERVENTION :</strong>
                                        <!-- Adresse ou lieu d'intervention saisi sur le dossier. -->
                                        <span t-field="o.lieu_intervention" />
                                    </div>
                                    <div class="dss-info-line">
                                        <strong>DATE D'INTERVENTION :</strong>
                                        <!-- t-field formate la date selon les paramètres régionaux Odoo. -->
                                        <span t-field="o.date_intervention" />
                                    </div>
                                    <div class="dss-info-line">
                                        <strong>EMPLACEMENT :</strong>
                                        <!-- display_name fournit le libellé complet de l'emplacement de stock. -->
                                        <span t-field="o.location_id.display_name" />
                                    </div>
                                </td>
                                <td class="dss-header-right">
                                    <!-- Encadre le numéro de la demande pour le repérer rapidement. -->
                                    <div class="dss-number-box dss-number-box-first">
                                        <strong>DSS :</strong>
                                        <!-- o désigne la demande courante de la boucle QWeb. -->
                                        <span t-field="o.name" />
                                    </div>
                                    <!-- Ajoute un saut de ligne visuel entre le numéro DSS et le BCI. -->
                                    <br />
                                    <div class="dss-number-box">
                                        <strong>BCI :</strong>
                                        <!-- Référence du bon de commande interne associée à la demande. -->
                                        <span t-field="o.bci" />
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Affiche les articles et leurs quantites. -->
                        <!-- Une ligne du tableau représente un article et ses quantités de suivi. -->
                        <table class="dss-products">
                            <thead>
                                <tr>
                                    <th class="dss-col-designation">
                                        DESIGNATION</th>
                                    <!-- Les colonnes suivantes reprennent les quantités et observations de la ligne DSS. -->
                                    <th class="dss-col-demandee"> QTE<br />DEMANDEE</th>
                                    <th class="dss-col-sortie"> QTE<br />SORTIE</th>
                                    <th class="dss-col-installee"> QTE<br />INSTALLEE</th>
                                    <th class="dss-col-retour">
                                        RETOUR</th>
                                    <th class="dss-col-observation">
                                        OBSERVATION</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- t-foreach parcourt les lignes One2many du dossier ; line désigne la ligne courante. -->
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td class="dss-product-name">
                                        <!-- Nom de l'article associé à la ligne de demande. -->
                                        <span t-field="line.product_id.name" />
                                    </td>
                                    <td class="dss-cell-center">
                                        <!-- Quantité demandée initialement par le demandeur. -->
                                        <span t-field="line.qty_demandee" />
                                    </td>
                                    <td class="dss-cell-center">
                                        <!-- Quantité réellement sortie du stock. -->
                                        <span t-field="line.qty_sortie" />
                                    </td>
                                    <td class="dss-cell-center">
                                        <!-- Quantité installée chez le client. -->
                                        <span t-field="line.qty_installee" />
                                    </td>
                                    <td class="dss-cell-center">
                                        <!-- Quantité retournée au stock. -->
                                        <span t-field="line.qty_retour" />
                                    </td>
                                    <td class="dss-product-observation">
                                        <!-- Observation saisie pour cet article. -->
                                        <span t-field="line.observation" />
                                    </td>
                                </tr>
                                <!-- Ajoute des lignes vides pour les demandes avec peu d'articles. -->
                                <!-- max(0, 2 - len(...)) évite un nombre négatif et complète le tableau à deux lignes. -->
                                <!-- range(n) répète le bloc n fois ; empty_row reçoit la valeur de boucle courante. -->
                                <tr t-foreach="range(max(0, 2 - len(o.line_ids)))" t-as="empty_row"
                                    class="dss-empty-row">
                                    <!-- &#160; est une espace insécable qui garde la cellule visible dans le tableau. -->
                                    <td>&#160;</td>
                                    <td>&#160;</td>
                                    <td>&#160;</td>
                                    <td>&#160;</td>
                                    <td>&#160;</td>
                                    <td>&#160;</td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Les cases de validation et les zones de signature. -->
                        <table class="dss-signatures">
                            <tr>
                                <!-- Première colonne : signature du demandeur. -->
                                <td class="dss-signature-cell">
                                    <strong>LE DEMANDEUR</strong>
                                    <!-- Les sauts de ligne réservent un espace pour la signature manuscrite. -->
                                    <br />
                                    <br />
                                    <span class="dss-checkbox">
                                        <!-- La case est cochee des que la demande a ete soumise. -->
                                        <!-- t-if rend cette case cochée si le dossier n'est plus en brouillon. -->
                                        <t t-if="o.state != 'brouillon'">&#9745;</t>
                                        <!-- La condition inverse affiche une case vide en état brouillon. -->
                                        <t t-if="o.state == 'brouillon'">&#9744;</t>
                                    </span>
                                    <!-- Le bloc signataire est rendu seulement si un demandeur est enregistré. -->
                                    <div class="dss-signatory" t-if="o.signataire_demandeur_id">
                                        <!-- Nom du demandeur ayant soumis la demande. -->
                                        <span t-field="o.signataire_demandeur_id.name" />
                                        <br />
                                        <!-- Date de soumission enregistrée dans le workflow. -->
                                        <span t-field="o.date_soumission" />
                                    </div>
                                </td>
                                <!-- Deuxième colonne : validation et signature du Chef DSS. -->
                                <td class="dss-signature-cell">
                                    <strong>CHEF DSS</strong>
                                    <br />
                                    <span class="dss-checkbox">
                                        <!-- Un signataire présent est évalué comme vrai et affiche une case cochée. -->
                                        <t t-if="o.signataire_chef_id">&#9745;</t>
                                        <!-- not inverse le test pour afficher une case vide en l'absence de signataire. -->
                                        <t t-if="not o.signataire_chef_id">&#9744;</t>
                                    </span>
                                    <!-- Les coordonnées sont affichées uniquement si le Chef a validé. -->
                                    <div class="dss-signatory" t-if="o.signataire_chef_id">
                                        <span t-field="o.signataire_chef_id.name" />
                                        <br />
                                        <span t-field="o.date_validation_chef" />
                                    </div>
                                </td>
                                <!-- Troisième colonne : validation et signature du magasinier. -->
                                <td class="dss-signature-cell">
                                    <strong>MAGASINIER</strong>
                                    <br />
                                    <span class="dss-checkbox">
                                        <!-- Case cochée lorsque le signataire Magasin existe. -->
                                        <t t-if="o.signataire_magasin_id">&#9745;</t>
                                        <!-- not exprime ici la condition contraire : aucun signataire Magasin. -->
                                        <t t-if="not o.signataire_magasin_id">&#9744;</t>
                                    </span>
                                    <!-- Affiche nom et date seulement si la validation Magasin a été enregistrée. -->
                                    <div class="dss-signatory" t-if="o.signataire_magasin_id">
                                        <span t-field="o.signataire_magasin_id.name" />
                                        <br />
                                        <span t-field="o.date_validation_magasin" />
                                    </div>
                                </td>
                                <!-- Zone vierge prévue pour la signature du service Sécurité. -->
                                <td class="dss-signature-cell">
                                    <strong>SECURITE</strong>
                                    <div class="dss-signature-space">&#160;</div>
                                    <div class="dss-signature-rule">
                                        Signature</div>
                                </td>
                                <!-- Zone vierge prévue pour la signature de la personne qui reçoit le matériel. -->
                                <td class="dss-signature-cell">
                                    <strong>RECU PAR</strong>
                                    <div class="dss-signature-space">&#160;</div>
                                    <div class="dss-signature-rule">
                                        Signature</div>
                                </td>
                            </tr>
                        </table>

                        <!-- Affiche l'état actuel de la demande sur le document imprimé. -->
                        <div class="dss-state">
                            <strong>Etat DSS :</strong>
                            <!-- t-field rend le libellé du champ state défini par le modèle Odoo. -->
                            <span t-field="o.state" />
                        </div>
                    </div>
                    <!-- Fin de la mise en page externe d'Odoo. -->
                </t>
                <!-- Fin du traitement de cette demande. La boucle continue s'il y en a d'autres. -->
            </t>
            <!-- Fin du conteneur HTML du rapport. -->
        </t>
        <!-- Fin du modèle de rapport. -->
    </template>
    <!-- Met a jour le format de papier utilise par le bon de livraison. -->
    <record id="paperformat_dss_a5" model="report.paperformat">
        <!-- Definit le format A5 paysage du bon de livraison. -->
        <field name="name">A5 DSS paysage</field>
        <!-- Ce format n'est pas le format par défaut du système. -->
        <field name="default" eval="False" />
        <!-- Utilise une feuille au format A5. -->
        <field name="format">A5</field>
        <!-- Landscape place la feuille en orientation horizontale. -->
        <field name="orientation">Landscape</field>
        <!-- Les marges sont exprimées en millimètres et réduites pour laisser plus de place au contenu. -->
        <!-- Espace entre le bord supérieur de la feuille et la zone imprimable. -->
        <field name="margin_top">30</field>
        <!-- Espace laissé sous le contenu imprimé. -->
        <field name="margin_bottom">10</field>
        <!-- Espace laissé à gauche du contenu. -->
        <field name="margin_left">7</field>
        <!-- Espace laissé à droite du contenu. -->
        <field name="margin_right">7</field>
        <!-- N'ajoute pas de ligne sous l'en-tête. -->
        <field name="header_line" eval="False" />
        <!-- Garde un espace reduit pour l'en-tete externe Odoo. -->
        <field name="header_spacing">25</field>
        <!-- La valeur 0 evite l'option DPI qui a cause le PDF blanc sous Windows. -->
        <field name="dpi">0</field>
    </record>

    <!-- Déclare l'action qui permet d'imprimer le bon depuis une demande DSS. -->
    <record id="action_report_bon_livraison" model="ir.actions.report.xml">
        <!-- Nom de l'action et libellé de l'impression. -->
        <field name="name">Bon de Livraison</field>
        <!-- Cette action concerne les enregistrements du modèle dss.request. -->
        <field name="model">dss.request</field>
        <!-- Produit un fichier PDF à partir du modèle QWeb. -->
        <field name="report_type">qweb-pdf</field>
        <!-- Indique à Odoo le modèle QWeb à utiliser. -->
        <field name="report_name">dss_v2.report_bon_livraison_document</field>
        <!-- Nom technique du fichier de rapport, correspondant au modèle QWeb. -->
        <field name="report_file">dss_v2.report_bon_livraison_document</field>
        <!-- Utilise le format A5 paysage defini ci-dessus. -->
        <field name="paperformat_id" ref="paperformat_dss_a5" />
        <!-- L'expression Python %s insère le numéro de demande dans le nom du PDF téléchargé. -->
        <field name="print_report_name">'Bon de Livraison - %s.pdf' % (object.name)</field>
        <!-- Fin de la déclaration de l'action d'impression. -->
    </record>
    <!-- Fin du fichier de données Odoo. -->
</odoo>