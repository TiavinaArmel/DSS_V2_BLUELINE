<?xml version="1.0" encoding="utf-8"?>
<!-- Élément racine obligatoire des fichiers de données chargés par Odoo. -->
<odoo>
    <!-- Déclare un enregistrement du modèle Odoo mail.template. -->
    <record id="mail_template_dss_workflow" model="mail.template">
        <!-- Nom interne affiché aux administrateurs dans la configuration des e-mails. -->
        <field name="name">DSS - Notification workflow</field>
        <!-- ref pointe vers l'identifiant XML du modèle d'enregistrement dss.request. -->
        <field name="model_id" ref="dss_v2.model_dss_request"/>
        <!-- ${...} insère une valeur calculée ; ctx.get(clé, valeur_par_défaut) lit le contexte Odoo. -->
        <field name="subject">DSS ${object.name} - ${ctx.get('dss_action_label', 'Notification')}</field>
        <!-- user.email fournit l'adresse de l'utilisateur courant ; or '' utilise une chaîne vide si elle manque. -->
        <field name="email_from">${user.email or ''}</field>
        <!-- Styles intégrés au HTML pour une meilleure compatibilité avec les clients e-mail. -->
        <!-- CDATA empêche XML d'interpréter les balises HTML comme des balises de configuration Odoo. -->
        <!-- Le contenu HTML présente l'action, la demande, les changements éventuels et un lien vers Odoo. -->
        <field name="body_html"><![CDATA[
## Ce contenu HTML est traite par Mako avant d'etre envoye comme courriel.
## ${...} insere une valeur Python ; les lignes % if et % for pilotent les blocs conditionnels et repetes.
## role="presentation" et les tableaux imbriques favorisent un rendu stable dans les logiciels de messagerie.
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"
       border="0" style="margin:0;padding:0;background-color:#f3f6fa;">
    <tr>
        <td align="center" style="padding:28px 12px;">
            <table role="presentation" width="600" cellpadding="0"
                   cellspacing="0" border="0"
                   style="width:100%;max-width:600px;background-color:#ffffff;
                          border:1px solid #e3eaf2;border-radius:10px;
                          overflow:hidden;font-family:Arial,Helvetica,sans-serif;
                          color:#24364b;">
                <tr>
                    <td style="background-color:#15365b;padding:26px 30px;
                               border-bottom:4px solid #f5b82e;">
                        <table role="presentation" width="100%" cellpadding="0"
                               cellspacing="0" border="0">
                            <tr>
                                <td style="font-size:23px;font-weight:bold;
                                           color:#ffffff;letter-spacing:1px;">
                                    ## ctx contient les donnees supplementaires transmises par le code Python.
                                    ## Affiche le logo fourni, ou le nom de la societe si aucune URL n'est disponible.
                                    % if ctx.get('dss_logo_url'):
                                    ## La valeur du contexte est inseree dans l'adresse de l'image.
                                    <img src="${ctx.get('dss_logo_url')}"
                                         alt="GulfSat Madagascar"
                                         width="180"
                                         style="display:block;width:180px;height:auto;
                                                border:0;"/>
                                    % else:
                                    GULFSAT MADAGASCAR
                                    % endif
                                </td>
                                <td align="right"
                                    style="font-size:11px;color:#d8e5f3;
                                           line-height:18px;">
                                    GESTION DES STOCKS<br/>
                                    DEMANDE DE SORTIE DE STOCK
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:30px 30px 18px 30px;">
                        <p style="margin:0 0 12px 0;font-size:23px;
                                  line-height:30px;font-weight:bold;
                                  color:#15365b;">
                            Bonjour,
                        </p>
                        % if ctx.get('dss_event_key') == 'stock_approval':
                        <table role="presentation" width="100%" cellpadding="0"
                               cellspacing="0" border="0"
                               style="margin:18px 0;background-color:#eaf6ee;
                                      border:1px solid #8ac79a;border-radius:6px;">
                            <tr>
                                <td style="padding:16px 18px;color:#216b35;
                                           font-size:15px;line-height:22px;">
                                    <strong>Étape suivante</strong><br/>
                                    Le stock a été mis à jour. Vous pouvez maintenant
                                    clôturer votre demande.
                                </td>
                            </tr>
                        </table>
                        % elif ctx.get('dss_event_key') == 'closure':
                        <table role="presentation" width="100%" cellpadding="0"
                               cellspacing="0" border="0"
                               style="margin:18px 0;background-color:#eef4fb;
                                      border:1px solid #9bbce0;border-radius:6px;">
                            <tr>
                                <td style="padding:16px 18px;color:#15365b;
                                           font-size:15px;line-height:22px;">
                                    <strong>Demande clôturée</strong><br/>
                                    La demande de sortie de stock est maintenant clôturée.
                                </td>
                            </tr>
                        </table>
                        % if ctx.get('dss_closure_type') == 'exception':
                        <table role="presentation" width="100%" cellpadding="0"
                               cellspacing="0" border="0"
                               style="margin:14px 0;background-color:#fff7e6;
                                      border:1px solid #e8c46a;border-radius:6px;">
                            <tr>
                                <td style="padding:14px 18px;color:#604c32;
                                           font-size:14px;line-height:21px;">
                                    <strong>Clôture exceptionnelle</strong><br/>
                                    Cette demande a été clôturée exceptionnellement par
                                    ${ctx.get('dss_closure_actor', '')}.<br/>
                                    <strong>Motif de la clôture exceptionnelle :</strong><br/>
                                    ${ctx.get('dss_closure_reason', '') or 'Non renseigné'}
                                </td>
                            </tr>
                        </table>
                        % endif
                        % endif
                        <p style="margin:0;font-size:15px;line-height:25px;
                                  color:#53657a;">
                            ## dss_event_key determine le message adapte a l'etape du workflow.
                            ## Les branches elif et else choisissent un seul texte a afficher.
                            % if ctx.get('dss_event_key') == 'stock_approval':
                            Votre demande a été validée par le magasin. Vous pouvez maintenant la consulter et la clôturer.
                            % elif ctx.get('dss_event_key') == 'closure':
                                ## Le contexte distingue une cloture exceptionnelle d'une cloture normale.
                                % if ctx.get('dss_closure_is_exception'):
                            La demande a été clôturée exceptionnellement par le Chef DSS.
                                % else:
                            La demande a été officiellement clôturée par le demandeur.
                                % endif
                            % elif ctx.get('dss_event_key') == 'stock_rejection':
                            ## get(clé, defaut) evite une valeur manquante si aucun motif n'a ete transmis.
                            La demande a été rejetée par le magasin. Motif : ${ctx.get('dss_motif', '') or 'Non renseigné'}.
                            % else:
                            Une demande de sortie de stock a fait l'objet
                            d'une nouvelle action dans le système DSS.
                            Retrouvez ci-dessous le récapitulatif de
                            la notification.
                            % endif
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 30px 22px 30px;">
                        <table role="presentation" width="100%" cellpadding="0"
                               cellspacing="0" border="0"
                               style="background-color:#f5f8fc;
                                      border:1px solid #e0e9f4;
                                      border-radius:8px;">
                            <tr>
                                <td style="padding:20px;">
                                    <p style="margin:0 0 7px 0;font-size:11px;
                                              font-weight:bold;color:#71839a;
                                              letter-spacing:1px;">
                                        REFERENCE DE LA DEMANDE
                                    </p>
                                    <p style="margin:0;font-size:21px;
                                              line-height:29px;font-weight:bold;
                                              color:#1769aa;word-break:break-word;">
                                        ## object est la demande DSS pour laquelle le modele de courriel est genere.
                                        ${object.name}
                                    </p>
                                    <table role="presentation" width="100%"
                                           cellpadding="0" cellspacing="0"
                                           border="0" style="margin-top:18px;">
                                        <tr>
                                            <td style="padding:10px 0;
                                                       border-top:1px solid #e0e9f4;
                                                       font-size:13px;color:#71839a;">
                                                Action effectuée
                                            </td>
                                            <td align="right"
                                                style="padding:10px 0;
                                                       border-top:1px solid #e0e9f4;
                                                       font-size:13px;font-weight:bold;
                                                       color:#24364b;">
                                                ## Lit l'intitule d'action du contexte, avec un texte de repli.
                                                ${ctx.get('dss_action_label', 'Notification')}
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:10px 0;
                                                       border-top:1px solid #e0e9f4;
                                                       font-size:13px;color:#71839a;">
                                                Demandeur
                                            </td>
                                            <td align="right"
                                                style="padding:10px 0;
                                                       border-top:1px solid #e0e9f4;
                                                       font-size:13px;font-weight:bold;
                                                       color:#24364b;">
                                                ## or affiche le nom du demandeur ou le texte indique s'il est absent.
                                                ${object.demandeur_id.name or 'Non renseigné'}
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:10px 0;
                                                       border-top:1px solid #e0e9f4;
                                                       font-size:13px;color:#71839a;">
                                                Service
                                            </td>
                                            <td align="right"
                                                style="padding:10px 0;
                                                       border-top:1px solid #e0e9f4;
                                                       font-size:13px;font-weight:bold;
                                                       color:#24364b;">
                                                ## Affiche le service associe, avec un texte de remplacement si besoin.
                                                ${object.service_demandeur_id.name or 'Non renseigné'}
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:10px 0;
                                                       border-top:1px solid #e0e9f4;
                                                       font-size:13px;color:#71839a;">
                                                Statut
                                            </td>
                                            <td align="right"
                                                style="padding:10px 0;
                                                       border-top:1px solid #e0e9f4;
                                                       font-size:13px;font-weight:bold;
                                                       color:#15365b;">
                                                ## Prend le statut du contexte, ou celui de l'enregistrement comme valeur de repli.
                                                ${ctx.get('dss_status', object.state)}
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                % if ctx.get('dss_event_key') == 'stock_approval' and ctx.get('dss_quantity_motifs'):
                <tr>
                    <td style="padding:0 30px 22px 30px;">
                        <table role="presentation" width="100%" cellpadding="0"
                               cellspacing="0" border="0"
                               style="background-color:#fff8ed;
                                      border-left:4px solid #e6a23c;">
                            <tr>
                                <td style="padding:16px 18px;">
                                    <p style="margin:0 0 8px 0;font-size:13px;
                                              font-weight:bold;color:#8b5b12;">
                                        Motif de modification des quantités
                                    </p>
                                    <ul style="margin:0;padding-left:20px;">
                                        % for quantity_motif in ctx.get('dss_quantity_motifs', []):
                                        <li style="margin-bottom:6px;">
                                            ${quantity_motif[0]} : ${quantity_motif[1]}
                                        </li>
                                        % endfor
                                    </ul>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                % elif ctx.get('dss_event_key') in ('chef_rejection', 'stock_rejection', 'return_to_requester') and ctx.get('dss_motif'):
                <tr>
                    <td style="padding:0 30px 22px 30px;">
                        <table role="presentation" width="100%" cellpadding="0"
                               cellspacing="0" border="0"
                               style="background-color:#fff8ed;
                                      border-left:4px solid #e6a23c;">
                            <tr>
                                <td style="padding:16px 18px;">
                                    <p style="margin:0 0 8px 0;font-size:13px;
                                              font-weight:bold;color:#8b5b12;">
                                        ## Le libelle du motif depend de l'evenement qui a declenche le message.
                                        % if ctx.get('dss_event_key') == 'closure':
                                        Motif de la clôture exceptionnelle
                                        % else:
                                        Motif / commentaire
                                        % endif
                                    </p>
                                    <p style="margin:0;font-size:14px;
                                              line-height:23px;color:#604c32;
                                              word-break:break-word;">
                                        ## Affiche le motif transmis ou un texte de remplacement s'il est vide.
                                        ${ctx.get('dss_motif', '') or ctx.get('dss_closure_reason', '') or 'Non renseigne'}
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                ## Termine le bloc conditionnel reserve au motif de rejet ou de cloture exceptionnelle.
                % endif
                <tr>
                    <td align="center" style="padding:4px 30px 12px 30px;">
                        <table role="presentation" cellpadding="0" cellspacing="0"
                               border="0">
                            <tr>
                                <td align="center" bgcolor="#1769aa"
                                    style="border-radius:6px;">
                                    ## Le contexte fournit l'URL directe de la demande a ouvrir dans Odoo.
                                    <a href="${ctx.get('dss_workflow_url', '')}"
                                       style="display:inline-block;padding:15px 28px;
                                              font-size:14px;font-weight:bold;
                                              line-height:20px;color:#ffffff;
                                              text-decoration:none;
                                              border-radius:6px;">
                                        Consulter la demande &gt;
                                    </a>
                                </td>
                            </tr>
                        </table>
                        <p style="margin:13px 0 0 0;font-size:12px;
                                  line-height:19px;color:#8795a7;">
                            Cliquez sur le bouton pour accéder à la demande
                            dans Odoo.
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:22px 30px 0 30px;">
                        <table role="presentation" width="100%" cellpadding="0"
                               cellspacing="0" border="0">
                            <tr>
                                <td style="border-top:1px solid #e8edf3;
                                           font-size:1px;line-height:1px;">
                                    &nbsp;
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="center" style="padding:20px 30px 24px 30px;">
                        <p style="margin:0 0 7px 0;font-size:13px;
                                  font-weight:bold;color:#15365b;">
                            GulfSat Madagascar
                        </p>
                        <p style="margin:0;font-size:12px;line-height:19px;
                                  color:#8795a7;">
                            Ce message est une notification automatique
                            du système de gestion des stocks.
                        </p>
                        <p style="margin:12px 0 0 0;font-size:11px;
                                  color:#a0acba;">
                            Fiabilité · Performance · Proximité
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
        ]]></field>
        <!-- Conserve la notification dans Odoo après son envoi pour permettre son suivi. -->
        <!-- eval interprète False comme un booléen ; le courriel reste conservé après son envoi. -->
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>