<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dss_department_form" model="ir.ui.view">
        <field name="name">hr.department.form.dss</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="string">Nom du service</attribute>
            </field>
            <field name="manager_id" position="attributes">
                <attribute name="string">Chef DSS</attribute>
            </field>
            <field name="manager_id" position="after">
                <field name="dss_demandeurs_ids" widget="many2many_tags"/>
            </field>
            <field name="parent_id" position="attributes">
                <attribute name="string">Département</attribute>
            </field>
        </field>
    </record>

    <record id="view_dss_department_tree" model="ir.ui.view">
        <field name="name">hr.department.tree.dss</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="display_name" position="attributes">
                <attribute name="string">Service</attribute>
            </field>
            <field name="manager_id" position="attributes">
                <attribute name="string">Chef DSS</attribute>
            </field>
        </field>
    </record>
</odoo>
