<?xml version="1.0" encoding="utf-8"?>
<!-- Ce fichier décrit un rapport PDF au format XML utilisé par Odoo. -->
<odoo>
    <!-- Hérite du bundle CSS commun aux rapports pour ajouter les styles du bon DSS. -->
    <template id="report_assets_dss" inherit_id="report.assets_common">
        <!-- Le point XPath . cible le bundle complet ; inside ajoute le lien sans remplacer son contenu. -->
        <xpath expr="." position="inside">
            <!-- Charge les styles du bon de livraison adaptés au rendu serveur. -->
            <link rel="stylesheet" type="text/css"
                href="/dss_v2/static/src/css/report_bl_server.css" />
        </xpath>
    </template>

    <template id="report_bon_livraison_layout">
        <t t-set="company" t-value="res_company" />
        <div class="header dss-bl-header">
            <table class="dss-bl-header-table" width="100%">
                <tr>
                    <td class="dss-bl-logo-cell" width="20%">
                        <img t-if="company.logo"
                            t-att-src="'data:image/png;base64,%s' % company.logo"
                            alt="Logo" />
                    </td>
                    <td class="dss-bl-title-cell" width="50%">
                        <strong>BON DE LIVRAISON</strong>
                    </td>
                    <td class="dss-bl-references-cell" width="30%">
                        <table class="dss-bl-reference" width="150">
                            <tr>
                                <td><strong>DSS :</strong> <span t-field="o.name" /></td>
                            </tr>
                        </table>
                        <table class="dss-bl-reference" width="150">
                            <tr>
                                <td><strong>BCI :</strong> <span t-field="o.bci" /></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
        <div class="article"
            t-att-data-oe-model="o and o._name"
            t-att-data-oe-id="o and o.id"
            t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0" />
        </div>
    </template>

    <!-- Definit le contenu du bon de livraison DSS. -->
    <!-- Cet identifiant QWeb est référencé par l'action d'impression plus bas. -->
    <template id="report_bon_livraison_document">
        <!-- Appelle le conteneur HTML standard requis par les rapports QWeb. -->
        <t t-call="report.html_container">
            <!-- docs contient les enregistrements demandés ; la boucle nomme chacun d'eux o. -->
            <t t-foreach="docs" t-as="o">
                <!-- Utilise le layout dédié sans modifier les autres rapports ni ajouter de pied standard. -->
                <t t-call="dss_v2.report_bon_livraison_layout">
                    <!-- Cette classe regroupe les styles propres au document. -->
                    <div class="page dss-bl">
                        <!-- Informations de livraison en grille pour le rendu PDF. -->
                        <table class="dss-info" width="100%">
                            <tr>
                                <td width="50%">
                                    <strong>DESTINATAIRE :</strong>
                                    <span t-field="o.partner_id.name" />
                                </td>
                                <td width="50%">
                                    <strong>DATE D'INTERVENTION :</strong>
                                    <span t-field="o.date_intervention" />
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>LIEU D'INTERVENTION :</strong>
                                    <span t-field="o.lieu_intervention" />
                                </td>
                                <td>
                                    <strong>TYPE D'INTERVENTION :</strong>
                                    <span t-field="o.type_intervention" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>EMPLACEMENT :</strong>
                                    <span t-field="o.location_id.display_name" />
                                </td>
                            </tr>
                        </table>
                        <table class="dss-spacer" width="100%">
                            <tr><td>&#160;</td></tr>
                        </table>

                        <!-- Une ligne représente un article et ses quantités de suivi. -->
                        <table class="dss-products" width="100%" border="1">
                            <thead>
                                <tr>
                                    <th class="dss-col-designation">DESIGNATION</th>
                                    <th class="dss-col-demandee">QUANTITÉ<br />DEMANDÉE</th>
                                    <th class="dss-col-sortie">QUANTITÉ<br />SORTIE</th>
                                    <th class="dss-col-installee">QUANTITÉ<br />INSTALLÉE</th>
                                    <th class="dss-col-retour">QUANTITÉ<br />RETOURNÉE</th>
                                    <th class="dss-col-observation">OBSERVATION</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td class="dss-product-name">
                                        <span t-field="line.product_id.name" />
                                    </td>
                                    <td class="dss-cell-center">
                                        <span t-field="line.qty_demandee" />
                                    </td>
                                    <td class="dss-cell-center">
                                        <span t-field="line.qty_sortie" />
                                    </td>
                                    <td class="dss-cell-center">
                                        <span t-field="line.qty_installee" />
                                    </td>
                                    <td class="dss-cell-center">
                                        <span t-field="line.qty_retour" />
                                    </td>
                                    <td class="dss-product-observation">
                                        <span t-field="line.observation" />
                                    </td>
                                </tr>
                                <tr class="dss-empty-row">
                                    <td>&#160;</td>
                                    <td>&#160;</td>
                                    <td>&#160;</td>
                                    <td>&#160;</td>
                                    <td>&#160;</td>
                                    <td>&#160;</td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="dss-spacer" width="100%">
                            <tr><td>&#160;</td></tr>
                        </table>

                        <!-- Les validations et les zones de signature. -->
                        <table class="dss-signatures">
                            <thead>
                                <tr>
                                    <th>LE DEMANDEUR</th>
                                    <th>CHEF DSS</th>
                                    <th>MAGASINIER</th>
                                    <th>SECURITE</th>
                                    <th>RECU PAR</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="dss-signature-cell">
                                        <span class="dss-checkbox">
                                            <t t-if="o.signataire_demandeur_id">&#9745;</t>
                                            <t t-if="not o.signataire_demandeur_id">&#9744;</t>
                                        </span>
                                        <br />
                                        <t t-if="o.signataire_demandeur_id">
                                            <span t-field="o.signataire_demandeur_id.name" />
                                            <br />
                                            <span t-field="o.date_soumission" />
                                        </t>
                                    </td>
                                    <td class="dss-signature-cell">
                                        <span class="dss-checkbox">
                                            <t t-if="o.signataire_chef_id">&#9745;</t>
                                            <t t-if="not o.signataire_chef_id">&#9744;</t>
                                        </span>
                                        <br />
                                        <t t-if="o.signataire_chef_id">
                                            <span t-field="o.signataire_chef_id.name" />
                                            <br />
                                            <span t-field="o.date_validation_chef" />
                                        </t>
                                    </td>
                                    <td class="dss-signature-cell">
                                        <span class="dss-checkbox">
                                            <t t-if="o.signataire_magasin_id">&#9745;</t>
                                            <t t-if="not o.signataire_magasin_id">&#9744;</t>
                                        </span>
                                        <br />
                                        <t t-if="o.signataire_magasin_id">
                                            <span t-field="o.signataire_magasin_id.name" />
                                            <br />
                                            <span t-field="o.date_validation_magasin" />
                                        </t>
                                    </td>
                                    <td class="dss-signature-cell">
                                        <br />
                                        <table class="dss-signature-line" width="80%">
                                            <tr><td>&#160;</td></tr>
                                        </table>
                                        Signature
                                    </td>
                                    <td class="dss-signature-cell">
                                        <br />
                                        <table class="dss-signature-line" width="80%">
                                            <tr><td>&#160;</td></tr>
                                        </table>
                                        Signature
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="dss-state" width="100%">
                            <tr>
                                <td>
                                    <strong>Etat DSS :</strong>
                                    <span t-field="o.state" />
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
                <!-- Fin du traitement de cette demande. La boucle continue s'il y en a d'autres. -->
            </t>
            <!-- Fin du conteneur HTML du rapport. -->
        </t>
        <!-- Fin du modèle de rapport. -->
    </template>
    <!-- Met a jour le format de papier utilise par le bon de livraison. -->
    <record id="paperformat_dss_a5" model="report.paperformat">
        <!-- Definit le format A5 paysage du bon de livraison. -->
        <field name="name">A5 DSS paysage</field>
        <!-- Ce format n'est pas le format par défaut du système. -->
        <field name="default" eval="False" />
        <!-- Utilise une feuille au format A5. -->
        <field name="format">A5</field>
        <!-- Landscape place la feuille en orientation horizontale. -->
        <field name="orientation">Landscape</field>
        <!-- Réserve l'espace nécessaire à l'en-tête répété et à son bloc de références. -->
        <field name="margin_top">22</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <!-- N'ajoute pas de ligne sous l'en-tête. -->
        <field name="header_line" eval="False" />
        <!-- Espace visible entre l'en-tête personnalisé et le contenu du rapport. -->
        <field name="header_spacing">10</field>
        <!-- La valeur 0 evite l'option DPI qui a cause le PDF blanc sous Windows. -->
        <field name="dpi">0</field>
    </record>

    <!-- Déclare l'action qui permet d'imprimer le bon depuis une demande DSS. -->
    <record id="action_report_bon_livraison" model="ir.actions.report.xml">
        <!-- Nom de l'action et libellé de l'impression. -->
        <field name="name">Bon de Livraison</field>
        <!-- Cette action concerne les enregistrements du modèle dss.request. -->
        <field name="model">dss.request</field>
        <!-- Produit un fichier PDF à partir du modèle QWeb. -->
        <field name="report_type">qweb-pdf</field>
        <!-- Indique à Odoo le modèle QWeb à utiliser. -->
        <field name="report_name">dss_v2.report_bon_livraison_document</field>
        <!-- Nom technique du fichier de rapport, correspondant au modèle QWeb. -->
        <field name="report_file">dss_v2.report_bon_livraison_document</field>
        <!-- Utilise le format A5 paysage defini ci-dessus. -->
        <field name="paperformat_id" ref="paperformat_dss_a5" />
        <!-- L'expression Python %s insère le numéro de demande dans le nom du PDF téléchargé. -->
        <field name="print_report_name">'Bon de Livraison - %s.pdf' % (object.name)</field>
        <!-- Fin de la déclaration de l'action d'impression. -->
    </record>
    <!-- Fin du fichier de données Odoo. -->
</odoo>