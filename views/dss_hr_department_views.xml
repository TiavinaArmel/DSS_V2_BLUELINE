<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue du formulaire utilisée uniquement par le menu Services de la DSS. -->
    <record id="view_dss_department_form" model="ir.ui.view">
        <field name="name">hr.department.form.dss</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <!-- La vue primaire évite d'appliquer ces libellés aux écrans RH standards. -->
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="string">Nom du service</attribute>
            </field>
            <!-- Remplace le responsable RH par les champs propres au workflow DSS. -->
            <field name="manager_id" position="replace">
                <!-- Le domaine limite le choix aux Chefs DSS actifs. -->
                <field name="dss_chef_id" string="Chef DSS"
                    domain="[('groups_id', 'in', [%(dss_v2.group_dss_chef)d]), ('active', '=', True)]"/>
                <field name="dss_demandeurs_ids" widget="many2many_tags"/>
            </field>
            <field name="parent_id" position="attributes">
                <attribute name="string">Département</attribute>
            </field>
        </field>
    </record>

    <!-- Vue de liste dédiée au menu Services de la DSS. -->
    <record id="view_dss_department_tree" model="ir.ui.view">
        <field name="name">hr.department.tree.dss</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <!-- La vue primaire isole les libellés DSS de l'application RH. -->
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="display_name" position="attributes">
                <attribute name="string">Service</attribute>
            </field>
            <!-- Affiche le Chef DSS configuré, plutôt que le responsable RH standard. -->
            <field name="manager_id" position="replace">
                <!-- Le domaine limite le choix aux Chefs DSS actifs. -->
                <field name="dss_chef_id" string="Chef DSS"
                    domain="[('groups_id', 'in', [%(dss_v2.group_dss_chef)d]), ('active', '=', True)]"/>
            </field>
        </field>
    </record>
</odoo>
