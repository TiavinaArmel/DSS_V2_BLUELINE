<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dss_request_search" model="ir.ui.view">
        <field name="name">dss.request.search</field>
        <field name="model">dss.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Numéro DSS"/>
                <field name="bci" string="BCI"/>
                <field name="partner_id" string="Client"/>
                <field name="lieu_intervention" string="Lieu d'intervention"/>
                <field name="line_ids" string="Article"
                    filter_domain="[('line_ids.product_id.name', 'ilike', self)]"/>

                <!--
                    Filtre : Aujourd'hui.
                    context_today() récupère la date actuelle selon le contexte
                    et le fuseau horaire de l'utilisateur Odoo.
                    La première condition sélectionne les demandes dont la date
                    d'intervention est supérieure ou égale à aujourd'hui.
                    La deuxième condition exclut les dates à partir de demain.
                    Le résultat couvre donc uniquement la journée actuelle.
                    strftime('%Y-%m-%d') convertit la date au format attendu
                    par un champ Odoo de type Date.
                -->
                <filter name="filter_aujourd_hui" string="Aujourd'hui"
                    domain="[('date_intervention', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_intervention', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>

                <!--
                    Filtre : Cette semaine.
                    weekday() retourne le numéro du jour de la semaine :
                    lundi vaut 0, mardi vaut 1, jusqu'à dimanche qui vaut 6.
                    La première borne retire ce nombre de jours à la date actuelle
                    afin d'obtenir le lundi de la semaine en cours.
                    La deuxième borne ajoute 7 jours à ce lundi pour obtenir
                    le lundi suivant, qui est exclu du résultat.
                    Le filtre couvre ainsi la semaine du lundi au dimanche.
                -->
                <filter name="filter_cette_semaine" string="Cette semaine"
                    domain="[('date_intervention', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('date_intervention', '&lt;', (context_today() - relativedelta(days=context_today().weekday()) + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>

                <!--
                    Filtre : Ce mois.
                    replace(day=1) remplace le jour actuel par le premier jour
                    du mois en cours : il s'agit de la borne de début incluse.
                    relativedelta(months=1) avance ensuite cette date d'un mois
                    pour obtenir le premier jour du mois suivant.
                    Cette deuxième borne est exclue afin de sélectionner toutes
                    les demandes du mois en cours, quel que soit son nombre de jours.
                -->
                <filter name="filter_ce_mois" string="Ce mois"
                    domain="[('date_intervention', '&gt;=', context_today().replace(day=1).strftime('%Y-%m-%d')), ('date_intervention', '&lt;', (context_today().replace(day=1) + relativedelta(months=1)).strftime('%Y-%m-%d'))]"/>

                <!--
                    Filtre : Avec écart.
                    has_ecart est le booléen enregistré sur dss.request.
                    La valeur True limite les résultats aux demandes pour lesquelles
                    un écart a été détecté lors du traitement ou de la clôture.
                -->
                <filter name="filter_avec_ecart" string="Avec écart"
                    domain="[('has_ecart', '=', True)]"/>

                <!--
                    Filtre : Transferts inter-sites.
                    La valeur technique appro_distant correspond au type
                    d'intervention « Approvisionnement de stock distant ».
                    Le filtre affiche donc uniquement les demandes de transfert
                    entre emplacements ou sites de stock.
                -->
                <filter name="filter_transferts_inter_sites" string="Transferts inter-sites"
                    domain="[('type_intervention', '=', 'appro_distant')]"/>

                <!--
                    Menu « Grouper par ».
                    Chaque filtre ci-dessous ne supprime pas les demandes :
                    il demande à Odoo de les présenter par catégories.
                    La clé group_by indique le champ utilisé pour constituer
                    les différents groupes dans la liste des demandes.
                -->
                <group string="Grouper par">
                    <!-- Regroupe les demandes selon leur état de workflow. -->
                    <filter name="group_by_state" string="État"
                        context="{'group_by': 'state'}"/>

                    <!-- Regroupe les demandes selon leur type d'intervention. -->
                    <filter name="group_by_type_intervention" string="Type d'intervention"
                        context="{'group_by': 'type_intervention'}"/>

                    <!-- Regroupe les demandes selon le client sélectionné. -->
                    <filter name="group_by_partner" string="Client"
                        context="{'group_by': 'partner_id'}"/>
                </group>

                <!--
                    Filtres réservés au groupe DSS / Chef.
                    L'attribut groups empêche les autres groupes, notamment
                    DSS / Magasin, de voir ces filtres dans la recherche.
                -->
                <filter name="chef_filter_a_valider" string="À valider"
                    groups="dss_v2.group_dss_chef"
                    domain="[('state', '=', 'valide_chef')]"/>
                <filter name="chef_filter_mes_validations" string="Mes validations"
                    groups="dss_v2.group_dss_chef"
                    domain="[('signataire_chef_id', '=', uid)]"/>
                <filter name="chef_filter_a_cloturer" string="À clôturer"
                    groups="dss_v2.group_dss_chef"
                    domain="[('state', '=', 'approuve')]"/>
                <filter name="chef_filter_rejetees" string="Rejetées"
                    groups="dss_v2.group_dss_chef"
                    domain="[('state', '=', 'rejete')]"/>

                <!--
                    Regroupements réservés au groupe DSS / Chef.
                    Le troisième regroupement utilise la granularité « week »
                    afin de présenter les demandes par semaine d'intervention.
                -->
                <group string="Grouper par (Chef)" groups="dss_v2.group_dss_chef">
                    <filter name="chef_group_by_demandeur" string="Demandeur"
                        groups="dss_v2.group_dss_chef"
                        context="{'group_by': 'signataire_demandeur_id'}"/>
                    <filter name="chef_group_by_valideur" string="Valideur Chef"
                        groups="dss_v2.group_dss_chef"
                        context="{'group_by': 'signataire_chef_id'}"/>
                    <filter name="chef_group_by_date_intervention_semaine"
                        string="Date d'intervention (par semaine)"
                        groups="dss_v2.group_dss_chef"
                        context="{'group_by': 'date_intervention:week'}"/>
                </group>

                <!--
                    Filtres réservés au groupe DSS / Magasin.
                    L'attribut groups limite leur affichage aux utilisateurs
                    appartenant au groupe dss_v2.group_dss_magasin.
                    Les utilisateurs qui ne possèdent pas ce groupe ne voient
                    pas ces filtres dans le menu de recherche.
                -->
                <filter name="magasin_filter_a_valider_stock" string="À valider Stock"
                    groups="dss_v2.group_dss_magasin"
                    domain="[('state', '=', 'valide_magasin')]"/>
                <filter name="magasin_filter_approuvees_a_remettre"
                    string="Approuvées (à remettre)"
                    groups="dss_v2.group_dss_magasin"
                    domain="[('state', '=', 'approuve')]"/>
                <filter name="magasin_filter_mes_validations_stock"
                    string="Mes validations Stock"
                    groups="dss_v2.group_dss_magasin"
                    domain="[('signataire_magasin_id', '=', uid)]"/>

                <!--
                    Regroupements réservés au groupe DSS / Magasin.
                    Le regroupement par date utilise la granularité « week »
                    pour afficher les demandes par semaine d'intervention.
                -->
                <group string="Grouper par (Magasin)" groups="dss_v2.group_dss_magasin">
                    <filter name="magasin_group_by_emplacement" string="Emplacement"
                        groups="dss_v2.group_dss_magasin"
                        context="{'group_by': 'location_id'}"/>
                    <filter name="magasin_group_by_valideur_stock" string="Valideur Stock"
                        groups="dss_v2.group_dss_magasin"
                        context="{'group_by': 'signataire_magasin_id'}"/>
                    <filter name="magasin_group_by_date_intervention_semaine"
                        string="Date d'intervention (par semaine)"
                        groups="dss_v2.group_dss_magasin"
                        context="{'group_by': 'date_intervention:week'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>